{
    "name": "bundlewatch-monorepo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.11.2",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "pnpm --recursive --filter=!@bundlewatch/website run build",
        "check": "oxfmt --check && oxlint --deny-warnings",
        "format": "oxfmt",
        "lint": "oxlint --deny-warnings",
        "typecheck": "pnpm --recursive run typecheck",
        "test": "pnpm --recursive --filter=!@bundlewatch/contract-tests run test",
        "test:contract": "pnpm --filter=@bundlewatch/contract-tests run test"
    },
    "devDependencies": {
        "@types/node": "^22.19.0",
        "oxfmt": "0.72.0",
        "oxlint": "1.87.0",
        "typescript": "7.0.2"
    }
}
